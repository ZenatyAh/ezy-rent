{
  "name": "ezy-rent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tz": "node scripts/test-tz.mjs",
    "test:int": "vitest run --config vitest.int.config.ts",
    "postinstall": "prisma generate",
    "db:reset": "npx supabase db reset",
    "db:pull": "prisma db pull",
    "db:sync": "npx supabase db reset && prisma db pull && prisma generate",
    "seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "probe": "tsx --conditions=react-server --env-file=.env.local scripts/probe-data-api.ts",
    "smoke:ui": "tsx --conditions=react-server --env-file=.env.local scripts/ui-smoke.ts",
    "race:webhook": "tsx --conditions=react-server --env-file=.env.local scripts/webhook-race.ts",
    "check:db": "tsx --conditions=react-server --env-file=.env.local scripts/check-constraints.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}

# Copy to .env.local (`cp .env.example .env.local`). The values below are the LOCAL Supabase
# stack defaults. If `npx supabase status` prints different ones, replace them.
# Never commit .env.local. The secret key must stay server-side (no NEXT_PUBLIC_ prefix).

# API URL of the local stack. From `npx supabase status` -> "API URL" (Project URL).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (safe for the browser). From `npx supabase status` -> "Publishable key".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Secret key (SERVER ONLY: Auth admin in the seed, Storage cleanup/upload). From `npx supabase status` -> "Secret key".
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Postgres connection used by Prisma (connects as the database owner, so it bypasses RLS).
# From `npx supabase status` -> "Database URL" (direct connection, port 54322).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct (non-pooled) connection for Prisma CLI / introspection. Same as DATABASE_URL on the local stack.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Shared secret the payment gateway uses to sign webhook callbacks (HMAC-SHA256).
# Local value chosen by us: it is the key from the brief's test vector. Not from Supabase.
GATEWAY_X_SIGNATURE_KEY=test_x_signature_key
